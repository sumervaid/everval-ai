# Set these variables in your shell. The application does not load .env automatically.
# Keep source files, private task collections, and runtime storage separate.
# CVALS_DATA_DIR=/absolute/path/to/custom-vals-data
# CVALS_TOKEN=choose-a-long-random-access-token
# CVALS_ALLOWED_HOSTS=your.internal.hostname
# CVALS_DOCKER_HOST=unix:///path/to/docker.sock
# CVALS_SANDBOX_IMAGE=python:3.12-slim
# CVALS_ALLOW_REMOTE_PROVIDERS=false
# Provider secrets are read from the environment variable named in each system.
# MY_PROVIDER_API_KEY=
