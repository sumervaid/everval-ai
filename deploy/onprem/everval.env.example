# Root-owned mode 0640, group everval. No credentials in this file.
# systemd EnvironmentFile syntax: assignments, no shell expansion or "export".
EVERVAL_DATA_DIR=/var/lib/everval
XDG_CACHE_HOME=/var/cache/everval
EVERVAL_ALLOW_REMOTE_PROVIDERS=false
EVERVAL_ALLOWED_HOSTS=127.0.0.1,localhost
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
UV_OFFLINE=1
UV_PYTHON_DOWNLOADS=never

# Optional internal inference. Add exact reviewed HTTPS origins only.
# EVERVAL_INTERNAL_PROVIDER_ORIGINS=https://inference.corp.example:8443
# EVERVAL_PROVIDER_CA_BUNDLE=/etc/everval/corporate-ca.pem

# Optional dedicated Docker daemon. Grant only reviewed daemon access.
# EVERVAL_DOCKER_HOST=unix:///run/everval-docker/docker.sock
# EVERVAL_SANDBOX_IMAGE=sha256:REPLACE_WITH_PREPARED_IMAGE_ID
