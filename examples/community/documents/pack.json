        "id": "demo-documents",
        "name": "Ground a refund answer in current policy",
        "domain": "documents",
        "description": "Checks the numeric answer, source identity, and verbatim quotation; semantic entailment is not assessed.",
        "instruction": "Using only the supplied sources, return refund_days for enterprise customers and citations with source_id and exact supporting quote. The archived policy is superseded.",
        "inputs": {
          "sources": [
            {
              "id": "refund-policy",
              "text": "Current policy. Enterprise customers may request a refund within 30 days of purchase."
            },
            {
              "id": "archived-policy",
              "text": "Archived policy: refunds were available within 14 days."
            }
          ]
        },
        "expected": {},
        "checks": [
          {
            "id": "refund-days",
            "name": "Current refund window",
            "kind": "numeric",
            "path": "refund_days",
            "expected": 30,
            "weight": 1.0,
            "required": true,
            "tolerance": 0.0
          },
          {
            "id": "grounded-citation",
            "name": "Verifiable current-policy quotation",
            "kind": "citation",
            "path": "citations",
            "expected": {
              "require_quote": true,
              "source_ids": [
                "refund-policy"
              ]
            },
            "weight": 1.0,
            "required": true,
            "tolerance": 0.0
          }
        ],
        "reference_output": {
          "citations": [
            {
              "quote": "Enterprise customers may request a refund within 30 days of purchase.",
              "source_id": "refund-policy"
            }
          ],
          "refund_days": 30
        },
